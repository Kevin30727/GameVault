<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta individual que infla VideojuegoAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:padding="16dp" android:background="@drawable/panel_bg" android:orientation="vertical">
    <TextView android:id="@+id/itemTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:maxLines="2"/>
    <TextView android:id="@+id/itemMetadatos" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="13sp"/>
    <TextView android:id="@+id/itemEstado" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>
